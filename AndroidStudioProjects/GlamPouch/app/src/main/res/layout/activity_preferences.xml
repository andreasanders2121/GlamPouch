<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GlamPouch Preferences"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Default Beauty Brand:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etDefaultBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., Fenty Beauty" />

    <Switch
        android:id="@+id/switchExpiryAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Enable Expiration Reminders"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSavePreferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Save Preferences" />

    <TextView
        android:id="@+id/tvSavedStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#008000"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnBackFromPreferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Back to Main Menu" />

</LinearLayout>